[global]
    width = 340
    offset = 16x16
    origin = top-right
    frame_width = 1
    frame_color = "#3A3A3A"
    font = DejaVu Sans 10
    corner_radius = 8
[urgency_low]
    background = "#202020"
    foreground = "#A0A0A0"
[urgency_normal]
    background = "#292929"
    foreground = "#F2F2F2"
    frame_color = "#FF781F"
[urgency_critical]
    background = "#292929"
    foreground = "#F2F2F2"
    frame_color = "#E05252"
