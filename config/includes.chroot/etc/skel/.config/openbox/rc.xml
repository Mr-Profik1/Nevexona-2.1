<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme><name>Clearlooks</name><titleLayout>NLIMC</titleLayout><font place="ActiveWindow"><name>DejaVu Sans</name><size>10</size></font></theme>
  <desktops><number>2</number></desktops>
  <keyboard>
    <keybind key="W-e"><action name="Execute"><command>pcmanfm</command></action></keybind>
    <keybind key="W-Return"><action name="Execute"><command>lxterminal</command></action></keybind>
    <keybind key="W-l"><action name="Execute"><command>loginctl lock-session</command></action></keybind>
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
    <keybind key="W-Right"><action name="GoToDesktop"><to>right</to></action></keybind>
    <keybind key="W-Left"><action name="GoToDesktop"><to>left</to></action></keybind>
  </keyboard>
</openbox_config>
